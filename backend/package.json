{
  "name": "world-cup-backend",
  "version": "1.0.0",
  "description": "World Cup 2026 prediction app backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "echo 'Build complete'",
    "start": "tsx src/index.ts",
    "migrate": "node scripts/migrate.js",
    "seed": "tsx scripts/seedFixtures.ts",
    "test": "jest --testPathPattern='(?<!integration)\\.test\\.ts$'",
    "test:watch": "jest --watch --testPathPattern='(?<!integration)\\.test\\.ts$'",
    "test:integration": "jest --testPathPattern='integration\\.test\\.ts$'",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "date-fns-tz": "^2.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "pg-native": "^3.0.1",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
